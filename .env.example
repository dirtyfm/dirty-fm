# Future Supabase backend option. These are public Supabase project values,
# not secrets. The active Vercel backend can run without these when
# DIRTYFM_CONTENT_BACKEND=cloudflare-kv and DIRTYFM_AUTH_MODE=local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Reserved for trusted maintenance scripts/server helpers.
# Never expose this in client components, browser bundles, or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=

# Local Signal Control auth plus Cloudflare KV content storage.
# Keep Supabase values above for a later backend switch.
# Cloudflare Workers deployments may instead use the DIRTYFM_CONTENT binding.
# Recognized values:
# DIRTYFM_AUTH_MODE=local | supabase
# DIRTYFM_CONTENT_BACKEND=cloudflare-kv | supabase
DIRTYFM_AUTH_MODE=
DIRTYFM_CONTENT_BACKEND=
DIRTYFM_OPERATOR_EMAIL=
DIRTYFM_OPERATOR_PASSPHRASE_HASH=
DIRTYFM_SESSION_SECRET=

# Required on Vercel when DIRTYFM_CONTENT_BACKEND=cloudflare-kv.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
