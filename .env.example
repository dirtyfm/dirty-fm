# Required for Supabase public reads, public form inserts, and browser-side
# Signal Control login. These are public Supabase project values, not secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Reserved for trusted maintenance scripts/server helpers.
# Never expose this in client components, browser bundles, or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=

# Temporary no-DB Signal Control mode. Keep Supabase values above for later.
# Set DIRTYFM_AUTH_MODE=local and DIRTYFM_CONTENT_BACKEND=cloudflare-kv
# when deploying with the Cloudflare KV namespace binding named DIRTYFM_CONTENT.
DIRTYFM_AUTH_MODE=
DIRTYFM_CONTENT_BACKEND=
DIRTYFM_OPERATOR_EMAIL=
DIRTYFM_OPERATOR_PASSPHRASE_HASH=
DIRTYFM_SESSION_SECRET=
