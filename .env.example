# Active production path: local Signal Control auth plus Cloudflare KV content storage.
# Cloudflare Workers deployments may instead use the DIRTYFM_CONTENT binding.
# Recognized values:
# DIRTYFM_AUTH_MODE=local | supabase
# DIRTYFM_CONTENT_BACKEND=cloudflare-kv | supabase
DIRTYFM_AUTH_MODE=local
DIRTYFM_CONTENT_BACKEND=cloudflare-kv
DIRTYFM_OPERATOR_EMAIL=
DIRTYFM_OPERATOR_PASSPHRASE_HASH=
DIRTYFM_SESSION_SECRET=

# Required on Vercel when DIRTYFM_CONTENT_BACKEND=cloudflare-kv.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Optional future Supabase backend/auth path. Leave blank for current production.
# These public project values are not secrets, but they are inactive unless the
# corresponding DIRTYFM_* mode is explicitly set to supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only Supabase key for trusted server helpers.
# Never expose this in client components, browser bundles, or NEXT_PUBLIC_* vars.
SUPABASE_SERVICE_ROLE_KEY=
